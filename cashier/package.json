{
  "name": "pkf-cashier",
  "version": "0.1.0",
  "private": true,
  "description": "Касса Пиксельного костра: четвертаки, леджер, PayPal (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev --env dev --local --port 8788 --persist-to .wrangler-state",
    "db:init:local": "wrangler d1 execute pkf-cashier --local --file schema.sql --persist-to .wrangler-state",
    "db:init:remote": "wrangler d1 execute pkf-cashier --remote --file schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
